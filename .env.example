# Gemini API key used by the server-side embedding endpoint.
GEMINI_API_KEY=

# Optional. Defaults to gemini-embedding-001.
GEMINI_EMBEDDING_MODEL=

# Optional. Defaults to gemini-3.8-flash for scanned-PDF OCR.
GEMINI_OCR_MODEL=

# Supabase Postgres REST credentials for durable document embeddings.
# Keep the service-role key server-only; never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
