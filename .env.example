# Gemini API key used by the server-side embedding endpoint.
GEMINI_API_KEY=

# Optional. Defaults to gemini-embedding-001.
GEMINI_EMBEDDING_MODEL=

# Optional. Defaults to gemini-3.8-flash for scanned-PDF OCR.
GEMINI_OCR_MODEL=

# Supabase browser-safe project credentials. Use the publishable key (sb_publishable_...)
# or the legacy anon key. Never put the service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Existing server-only credentials used for durable document embeddings.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
